@using LoxNet.Bridge.Ui.Models

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <FluentLabel Typo="Typography.H5">@(IsEditing ? "Edit Mapping" : "Add New Mapping")</FluentLabel>

    <FluentTextField @bind-Value="@Model.Name" Label="Mapping Name" Required Placeholder="e.g., Kitchen Lights" />

    <FluentSelect TOption="LoxoneSubcontrolOption"
                  Items="@LoxoneSubcontrols"
                  @bind-SelectedOption="@_selectedLoxoneSubcontrol"
                  OptionText="@(item => $"{item.ParentName} - {item.SubcontrolName}")"
                  OptionValue="@(item => item.UuidAction)"
                  Label="Loxone Sub-Control"
                  Height="300px"
                  OptionStyle="height: auto; padding: 6px 8px;"
                  Required
                  Placeholder="Select a Loxone sub-control">
        <OptionTemplate>
            <div style="display: flex; flex-direction: column;">
                <strong>@context.SubcontrolName</strong>
                <small>@context.ParentName (@context.Type)</small>
            </div>
        </OptionTemplate>
    </FluentSelect>

    <FluentSelect TOption="MqttLightOption"
                  Items="@MqttLights"
                  @bind-SelectedOption="@_selectedMqttLight"
                  OptionText="@(item => item.FriendlyName)"
                  OptionValue="@(item => item.Topic)"
                  Label="MQTT Light Device"
                  Height="300px"
                  OptionStyle="height: auto; padding: 6px 8px;"
                  Required
                  Placeholder="Select an MQTT light device">
        <OptionTemplate>
            <div style="display: flex; flex-direction: column;">
                <strong>@context.FriendlyName</strong>
                <small>@context.Model</small>
            </div>
        </OptionTemplate>
    </FluentSelect>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
        <FluentButton Appearance="Appearance.Accent"
                      OnClick="HandleSave"
                      Disabled="@(!IsValid)">
            @(IsEditing ? "Update" : "Add") Mapping
        </FluentButton>
        <FluentButton Appearance="Appearance.Neutral"
                      OnClick="HandleCancel">
            Cancel
        </FluentButton>
    </FluentStack>
</FluentStack>

@code {
    private LoxoneSubcontrolOption? _selectedLoxoneSubcontrol;
    private MqttLightOption? _selectedMqttLight;

    [Parameter]
    public MappingEditorModel Model { get; set; } = new();

    [Parameter]
    public IEnumerable<LoxoneSubcontrolOption> LoxoneSubcontrols { get; set; } = Array.Empty<LoxoneSubcontrolOption>();

    [Parameter]
    public IEnumerable<MqttLightOption> MqttLights { get; set; } = Array.Empty<MqttLightOption>();

    [Parameter]
    public bool IsEditing { get; set; }

    [Parameter]
    public EventCallback<MappingEditorModel> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(Model.Name) &&
        !string.IsNullOrWhiteSpace(Model.LoxoneUuidAction) &&
        !string.IsNullOrWhiteSpace(Model.MqttTopic);

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Model.LoxoneUuidAction))
        {
            _selectedLoxoneSubcontrol = LoxoneSubcontrols.FirstOrDefault(s => s.UuidAction == Model.LoxoneUuidAction);
        }

        if (!string.IsNullOrWhiteSpace(Model.MqttTopic))
        {
            _selectedMqttLight = MqttLights.FirstOrDefault(l => l.Topic == Model.MqttTopic);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_selectedLoxoneSubcontrol is not null)
        {
            Model.LoxoneUuidAction = _selectedLoxoneSubcontrol.UuidAction;
        }

        if (_selectedMqttLight is not null)
        {
            Model.MqttTopic = _selectedMqttLight.Topic;
        }
    }

    private async Task HandleSave()
    {
        if (IsValid)
        {
            await OnSave.InvokeAsync(Model);
        }
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }
}
