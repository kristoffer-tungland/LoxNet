    }
}
    private ConfigEditorModel _model = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isConnecting;
    private bool _showMappingWizard;
    private bool _isEditingMapping;
    private MappingEditorModel _currentMapping = new();
    private List<LoxoneSubcontrolOption> _loxoneSubcontrols = new();
    private List<MqttLightOption> _mqttLights = new();

    protected override async Task OnInitializedAsync()
    {
        ConnectionStatus.StartMonitoring();
        ConnectionStatus.ConnectionStatusChanged += OnConnectionStatusChanged;
        await LoadConfigAsync().ConfigureAwait(false);
        await LoadDeviceListsAsync().ConfigureAwait(false);
    }

    public void Dispose()
    {
        ConnectionStatus.StopMonitoring();
        ConnectionStatus.ConnectionStatusChanged -= OnConnectionStatusChanged;
    }

    private void OnConnectionStatusChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadConfigAsync()
    {
        _isLoading = true;
        try
        {
            var client = CreateClient();
            var dto = await client.GetFromJsonAsync<BridgeConfigDto>("config").ConfigureAwait(false);
            if (dto is not null)
            {
                _model = MapToEditor(dto);
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowToastAsync(new ToastParameters<string>
            {
                Intent = ToastIntent.Error,
                Title = "Failed to load configuration",
                Content = ex.Message,
                Timeout = 5000
            });
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadDeviceListsAsync()
    {
        var client = CreateClient();
        
        try
        {
            var response = await client.GetAsync("/api/loxone/subcontrols").ConfigureAwait(false);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
                _loxoneSubcontrols = System.Text.Json.JsonSerializer.Deserialize<List<LoxoneSubcontrolOption>>(json, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
        }
        catch
        {
            // Silently fail
        }

        try
        {
            var response = await client.GetAsync("/api/mqtt/lights").ConfigureAwait(false);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
                var mqttResponse = System.Text.Json.JsonSerializer.Deserialize<MqttLightsDiscoveryResult>(json, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (mqttResponse?.Lights is not null)
                {
                    _mqttLights = mqttResponse.Lights.Select(d => new MqttLightOption
                    {
                        FriendlyName = d.FriendlyName,
                        Topic = d.Topic,
                        Model = d.Model
                    }).ToList();
                }
            }
        }
        catch
        {
            // Silently fail
        }
    }

    private async Task ConnectLoxoneAsync()
    {
        _isConnecting = true;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsJsonAsync("/api/loxone/connect", new LoxoneSectionDto
            {
                Host = _model.Loxone.Host,
                Port = _model.Loxone.Port,
                UseHttps = _model.Loxone.UseHttps,
                User = _model.Loxone.User,
                Password = _model.Loxone.Password,
                Loxapp3Path = _model.Loxone.Loxapp3Path,
                RefreshLoxapp3OnStart = _model.Loxone.RefreshLoxapp3OnStart
            }).ConfigureAwait(false);

            if (response.IsSuccessStatusCode)
            {
                await ToastService.ShowToastAsync(new ToastParameters<string>
                {
                    Intent = ToastIntent.Success,
                    Title = "Loxone Connected",
                    Content = "Successfully connected to Miniserver",
                    Timeout = 3000
                });
                
                // Reload device lists
                await LoadDeviceListsAsync().ConfigureAwait(false);
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>().ConfigureAwait(false);
                var errorMessage = error?.TryGetValue("error", out var msg) == true ? msg : "Connection failed";
                
                await ToastService.ShowToastAsync(new ToastParameters<string>
                {
                    Intent = ToastIntent.Error,
                    Title = "Connection Failed",
                    Content = errorMessage,
                    Timeout = 5000
                });
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowToastAsync(new ToastParameters<string>
            {
                Intent = ToastIntent.Error,
                Title = "Connection Error",
                Content = ex.Message,
                Timeout = 5000
            });
        }
        finally
        {
            _isConnecting = false;
        }
    }

    private async Task ConnectMqttAsync()
    {
        _isConnecting = true;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsJsonAsync("/api/mqtt/connect", new MqttSectionDto
            {
                Host = _model.Mqtt.Host,
                Port = _model.Mqtt.Port,
                Username = _model.Mqtt.Username,
                Password = _model.Mqtt.Password,
                ClientId = _model.Mqtt.ClientId,
                BaseTopic = _model.Mqtt.BaseTopic
            }).ConfigureAwait(false);

            if (response.IsSuccessStatusCode)
            {
                await ToastService.ShowToastAsync(new ToastParameters<string>
                {
                    Intent = ToastIntent.Success,
                    Title = "MQTT Connected",
                    Content = "Successfully connected to MQTT broker",
                    Timeout = 3000
                });
                
                // Reload device lists
                await LoadDeviceListsAsync().ConfigureAwait(false);
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>().ConfigureAwait(false);
                var errorMessage = error?.TryGetValue("error", out var msg) == true ? msg : "Connection failed";
                
                await ToastService.ShowToastAsync(new ToastParameters<string>
                {
                    Intent = ToastIntent.Error,
                    Title = "Connection Failed",
                    Content = errorMessage,
                    Timeout = 5000
                });
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowToastAsync(new ToastParameters<string>
            {
                Intent = ToastIntent.Error,
                Title = "Connection Error",
                Content = ex.Message,
                Timeout = 5000
            });
        }
        finally
        {
            _isConnecting = false;
        }
    }

    private async Task SaveConfigAsync()
    {
        _isSaving = true;
        try
        {
            var client = CreateClient();
            var payload = MapToDto(_model);
            var response = await client.PostAsJsonAsync("config", payload).ConfigureAwait(false);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ConfigSaveResult>().ConfigureAwait(false);
                
                await ToastService.ShowToastAsync(new ToastParameters<string>
                {
                    Intent = ToastIntent.Success,
                    Title = "Configuration Saved",
                    Content = result?.Message ?? "Configuration saved successfully",
                    Timeout = 3000
                });
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>().ConfigureAwait(false);
                var errorMessage = error?.TryGetValue("error", out var msg) == true ? msg : "Failed to save configuration";
                
                await ToastService.ShowToastAsync(new ToastParameters<string>
                {
                    Intent = ToastIntent.Error,
                    Title = "Save Failed",
                    Content = errorMessage,
                    Timeout = 5000
                });
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowToastAsync(new ToastParameters<string>
            {
                Intent = ToastIntent.Error,
                Title = "Error",
                Content = $"Failed to save configuration: {ex.Message}",
                Timeout = 5000
            });
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ShowAddMappingWizard()
    {
        _currentMapping = new MappingEditorModel { Kind = "Dimmer" };
        _isEditingMapping = false;
        _showMappingWizard = true;
    }

    private void HideMappingWizard()
    {
        _showMappingWizard = false;
        _currentMapping = new MappingEditorModel();
    }

    private async Task SaveMappingAsync(MappingEditorModel mapping)
    {
        if (_isEditingMapping)
        {
            var index = _model.Mappings.FindIndex(m => m == _currentMapping);
            if (index >= 0)
            {
                _model.Mappings[index] = mapping;
            }
        }
        else
        {
            _model.Mappings.Add(mapping);
        }

        HideMappingWizard();
        
        await ToastService.ShowToastAsync(new ToastParameters<string>
        {
            Intent = ToastIntent.Success,
            Title = "Mapping Added",
            Content = $"Mapping '{mapping.Name}' has been added",
            Timeout = 3000
        });
    }

    private void RemoveMapping(MappingEditorModel mapping)
    {
        _model.Mappings.Remove(mapping);
    }

    private string GetMappingStatus(MappingEditorModel mapping)
    {
        // This is a placeholder - in a real implementation, we'd check against the health endpoint
        return "ok";
    }

    private HttpClient CreateClient()
    {
        var client = HttpClientFactory.CreateClient();
        client.BaseAddress = new Uri(Navigation.BaseUri);
        return client;
    }

    private static ConfigEditorModel MapToEditor(BridgeConfigDto dto)
    {
        return new ConfigEditorModel
        {
            Loxone = new LoxoneEditorModel
            {
                Host = dto.Loxone.Host,
                Port = dto.Loxone.Port,
                UseHttps = dto.Loxone.UseHttps,
                User = dto.Loxone.User,
                Password = dto.Loxone.Password,
                Loxapp3Path = dto.Loxone.Loxapp3Path,
                RefreshLoxapp3OnStart = dto.Loxone.RefreshLoxapp3OnStart
            },
            Mqtt = new MqttEditorModel
            {
                Host = dto.Mqtt.Host,
                Port = dto.Mqtt.Port,
                Username = dto.Mqtt.Username,
                Password = dto.Mqtt.Password,
                ClientId = dto.Mqtt.ClientId,
                BaseTopic = dto.Mqtt.BaseTopic
            },
            Mappings = dto.Mappings
                .Select(m => new MappingEditorModel
                {
                    Name = m.Name,
                    Kind = m.Kind,
                    MqttTopic = m.MqttTopic,
                    LoxoneUuidAction = m.LoxoneUuidAction,
                    Options = new MappingOptionsEditorModel
                    {
                        PreferMqttState = m.Options.PreferMqttState,
                        AllowColor = m.Options.AllowColor
                    }
                })
                .ToList()
        };
    }

