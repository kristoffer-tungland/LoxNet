@page "/"
@using LoxNet.Bridge.Ui.Components
@using LoxNet.Bridge.Ui.Models
@using LoxNet.Bridge.Config
@using LoxNet.Bridge.Api
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavManager
@inject NavigationManager Navigation
@inject ConnectionStatusService ConnectionStatus
@implements IDisposable

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" Style="padding: 20px;">
    @* Health Status Section *@
    <FluentCard>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentLabel Typo="Typography.H4">Connection Status</FluentLabel>
            
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="20">
                @* Loxone Status *@
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                    <FluentBadge Appearance="@(ConnectionStatus.IsLoxoneConnected ? Appearance.Accent : Appearance.Neutral)">
                        Miniserver: @(ConnectionStatus.IsLoxoneConnected ? "✓ Connected" : "✕ Disconnected")
                    </FluentBadge>
                    @if (!ConnectionStatus.IsLoxoneConnected && !string.IsNullOrWhiteSpace(_model.Loxone.Host))
                    {
                        <FluentButton Appearance="Appearance.Lightweight" OnClick="ConnectLoxoneAsync" Disabled="@_isConnecting">
                            Retry
                        </FluentButton>
                    }
                </FluentStack>

                @* MQTT Status *@
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8">
                    <FluentBadge Appearance="@(ConnectionStatus.IsMqttConnected ? Appearance.Accent : Appearance.Neutral)">
                        MQTT: @(ConnectionStatus.IsMqttConnected ? "✓ Connected" : "✕ Disconnected")
                    </FluentBadge>
                    @if (!ConnectionStatus.IsMqttConnected && !string.IsNullOrWhiteSpace(_model.Mqtt.Host))
                    {
                        <FluentButton Appearance="Appearance.Lightweight" OnClick="ConnectMqttAsync" Disabled="@_isConnecting">
                            Retry
                        </FluentButton>
                    }
                </FluentStack>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    @if (_isLoading)
    {
        <FluentCard>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="12">
                <FluentProgressRing />
                <FluentLabel>Loading configuration…</FluentLabel>
            </FluentStack>
        </FluentCard>
    }
    else
    {
        @* Message Bar for errors/success *@
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <FluentMessageBar Intent="@MessageIntent.Success">@_statusMessage</FluentMessageBar>
        }
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <FluentMessageBar Intent="@MessageIntent.Error">@_errorMessage</FluentMessageBar>
        }

        @* Loxone Connection Section *@
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <FluentLabel Typo="Typography.H4">Miniserver Connection</FluentLabel>
                
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true">
                    <FluentTextField @bind-Value="_model.Loxone.Host" Label="Host" Required Style="min-width: 200px;" />
                    <FluentNumberField @bind-Value="_model.Loxone.Port" Label="Port" Required Style="width: 120px;" />
                    <FluentTextField @bind-Value="_model.Loxone.User" Label="User" Required Style="min-width: 150px;" />
                    <FluentTextField @bind-Value="_model.Loxone.Password" Label="Password" TextFieldType="TextFieldType.Password" Required Style="min-width: 150px;" />
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
                    <FluentCheckbox @bind-Value="_model.Loxone.UseHttps" Label="Use HTTPS" />
                </FluentStack>

                <FluentButton Appearance="Appearance.Accent" OnClick="ConnectLoxoneAsync" Disabled="@_isConnecting">
                    @if (_isConnecting)
                    {
                        <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 8px;" />
                    }
                    Test & Connect
                </FluentButton>
            </FluentStack>
        </FluentCard>

        @* MQTT Connection Section *@
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <FluentLabel Typo="Typography.H4">MQTT Broker</FluentLabel>
                
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true">
                    <FluentTextField @bind-Value="_model.Mqtt.Host" Label="Host" Required Style="min-width: 200px;" />
                    <FluentNumberField @bind-Value="_model.Mqtt.Port" Label="Port" Required Style="width: 120px;" />
                    <FluentTextField @bind-Value="_model.Mqtt.Username" Label="Username (Optional)" Style="min-width: 150px;" />
                    <FluentTextField @bind-Value="_model.Mqtt.Password" Label="Password (Optional)" TextFieldType="TextFieldType.Password" Style="min-width: 150px;" />
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true">
                    <FluentTextField @bind-Value="_model.Mqtt.ClientId" Label="Client ID" Required Style="min-width: 200px;" />
                    <FluentTextField @bind-Value="_model.Mqtt.BaseTopic" Label="Base Topic" Required Style="min-width: 200px;" />
                </FluentStack>

                <FluentButton Appearance="Appearance.Accent" OnClick="ConnectMqttAsync" Disabled="@_isConnecting">
                    @if (_isConnecting)
                    {
                        <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 8px;" />
                    }
                    Test & Connect
                </FluentButton>
            </FluentStack>
        </FluentCard>

        @* Mappings Section *@
        <FluentCard>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12" Style="justify-content: space-between;">
                    <FluentLabel Typo="Typography.H4">Light Mappings</FluentLabel>
                    <FluentButton Appearance="Appearance.Accent" OnClick="ShowAddMappingAsync">
                        + Add Mapping
                    </FluentButton>
                </FluentStack>

                @if (_model.Mappings.Count == 0)
                {
                    <FluentLabel Typo="Typography.Body" Style="font-style: italic; color: var(--neutral-foreground-hint);">
                        No mappings configured. Click "Add Mapping" to create one.
                    </FluentLabel>
                }
                else
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                        @foreach (var (mapping, index) in _model.Mappings.Select((m, i) => (m, i)))
                        {
                            <FluentCard Style="background: var(--neutral-layer-2); padding: 12px;">
                                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12" Style="justify-content: space-between;">
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                                        <FluentLabel Style="font-weight: 600">@mapping.Name</FluentLabel>
                                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">
                                            @mapping.Kind | MQTT: @mapping.MqttTopic
                                        </FluentLabel>
                                        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint); font-size: 0.8em;">
                                            @GetMappingStatus(mapping)
                                        </FluentLabel>
                                    </FluentStack>
                                    <FluentButton Appearance="Appearance.Lightweight" OnClick="() => RemoveMapping(index)">
                                        Delete
                                    </FluentButton>
                                </FluentStack>
                            </FluentCard>
                        }
                    </FluentStack>
                }
            </FluentStack>
        </FluentCard>

        @* Save Button *@
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right" HorizontalGap="12">
            <FluentButton Appearance="Appearance.Accent" OnClick="SaveConfigAsync" Disabled="@_isSaving">
                @if (_isSaving)
                {
                    <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 8px;" />
                }
                Save Configuration
            </FluentButton>
        </FluentStack>
    }
</FluentStack>

@* Mapping Wizard Modal *@
@if (_showMappingWizard)
{
    <FluentDialog @bind-Open="_showMappingWizard" Modal="true">
        <MappingWizard Model="_newMapping"
                       LoxoneSubcontrols="_loxoneSubcontrols"
                       MqttLights="_mqttLights"
                       OnSave="HandleMappingSaveAsync"
                       OnCancel="HandleMappingCancel" />
    </FluentDialog>
}

@code {
    private ConfigEditorModel _model = new();
    private bool _isLoading = true;
    private bool _isConnecting;
    private bool _isSaving;
    private bool _showMappingWizard;
    private MappingEditorModel _newMapping = new();
    private List<LoxoneSubcontrolOption> _loxoneSubcontrols = new();
    private List<MqttLightOption> _mqttLights = new();
    private string? _statusMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        ConnectionStatus.StartMonitoring();
        ConnectionStatus.ConnectionStatusChanged += OnConnectionStateChanged;
        await LoadConfigAsync();
    }

    public void Dispose()
    {
        ConnectionStatus.ConnectionStatusChanged -= OnConnectionStateChanged;
        ConnectionStatus.StopMonitoring();
    }

    private void OnConnectionStateChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadConfigAsync()
    {
        _isLoading = true;
        _statusMessage = null;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(NavManager.BaseUri);
            var response = await client.GetAsync("config");
            var json = await response.Content.ReadAsStringAsync();
            var config = System.Text.Json.JsonSerializer.Deserialize<BridgeConfig>(json, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            
            if (config != null)
            {
                _model = new ConfigEditorModel
                {
                    Loxone = new LoxoneEditorModel
                    {
                        Host = config.Loxone.Host,
                        Port = config.Loxone.Port,
                        UseHttps = config.Loxone.UseHttps,
                        User = config.Loxone.User,
                        Password = config.Loxone.Password
                    },
                    Mqtt = new MqttEditorModel
                    {
                        Host = config.Mqtt.Host,
                        Port = config.Mqtt.Port,
                        Username = config.Mqtt.Username,
                        Password = config.Mqtt.Password,
                        ClientId = config.Mqtt.ClientId,
                        BaseTopic = config.Mqtt.BaseTopic
                    },
                    Mappings = config.Mappings.Select(m => new MappingEditorModel
                    {
                        Name = m.Name,
                        Kind = m.Kind,
                        MqttTopic = m.MqttTopic,
                        LoxoneUuidAction = m.LoxoneUuidAction
                    }).ToList()
                };
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load config: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConnectLoxoneAsync()
    {
        _isConnecting = true;
        _statusMessage = null;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(NavManager.BaseUri);
            var content = System.Text.Json.JsonSerializer.Serialize(new
            {
                Host = _model.Loxone.Host,
                Port = _model.Loxone.Port,
                User = _model.Loxone.User,
                Password = _model.Loxone.Password,
                UseHttps = _model.Loxone.UseHttps
            });
            var httpContent = new StringContent(content, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync("/api/loxone/connect", httpContent);
            
            if (response.IsSuccessStatusCode)
            {
                _statusMessage = "Miniserver connected successfully";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Failed to connect: {error}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Connection error: {ex.Message}";
        }
        finally
        {
            _isConnecting = false;
            StateHasChanged();
        }
    }

    private async Task ConnectMqttAsync()
    {
        _isConnecting = true;
        _statusMessage = null;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(NavManager.BaseUri);
            var content = System.Text.Json.JsonSerializer.Serialize(new
            {
                Host = _model.Mqtt.Host,
                Port = _model.Mqtt.Port,
                Username = _model.Mqtt.Username,
                Password = _model.Mqtt.Password,
                ClientId = _model.Mqtt.ClientId,
                BaseTopic = _model.Mqtt.BaseTopic
            });
            var httpContent = new StringContent(content, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync("/api/mqtt/connect", httpContent);
            
            if (response.IsSuccessStatusCode)
            {
                _statusMessage = "MQTT connected successfully";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Failed to connect: {error}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Connection error: {ex.Message}";
        }
        finally
        {
            _isConnecting = false;
            StateHasChanged();
        }
    }

    private async Task ShowAddMappingAsync()
    {
        _newMapping = new MappingEditorModel();
        _statusMessage = null;
        _errorMessage = null;

        try
        {
            // Load Loxone subcontrols
            using var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(NavManager.BaseUri);
            var loxResponse = await client.GetAsync("/api/loxone/subcontrols");
            var loxJson = await loxResponse.Content.ReadAsStringAsync();
            _loxoneSubcontrols = System.Text.Json.JsonSerializer.Deserialize<List<LoxoneSubcontrolOption>>(loxJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();

            // Load MQTT lights
            var mqttResponse = await client.GetAsync("/api/mqtt/lights");
            var mqttJson = await mqttResponse.Content.ReadAsStringAsync();
            var result = System.Text.Json.JsonSerializer.Deserialize<MqttLightsDiscoveryResult>(mqttJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            _mqttLights = result?.Lights.Select(d => new MqttLightOption
            {
                FriendlyName = d.FriendlyName,
                Topic = d.Topic,
                Model = d.Model
            }).ToList() ?? new();

            _showMappingWizard = true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load device lists: {ex.Message}";
        }

        StateHasChanged();
    }

    private Task HandleMappingSaveAsync()
    {
        _model.Mappings.Add(new MappingEditorModel
        {
            Name = _newMapping.Name,
            Kind = _newMapping.Kind,
            MqttTopic = _newMapping.MqttTopic,
            LoxoneUuidAction = _newMapping.LoxoneUuidAction
        });
        
        _showMappingWizard = false;
        _statusMessage = $"Mapping '{_newMapping.Name}' added. Remember to save!";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void HandleMappingCancel()
    {
        _showMappingWizard = false;
        StateHasChanged();
    }

    private void RemoveMapping(int index)
    {
        var name = _model.Mappings[index].Name;
        _model.Mappings.RemoveAt(index);
        _statusMessage = $"Mapping '{name}' removed. Remember to save!";
        StateHasChanged();
    }

    private async Task SaveConfigAsync()
    {
        _isSaving = true;
        _statusMessage = null;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(NavManager.BaseUri);
            
            // Convert to BridgeConfig
            var config = new BridgeConfig
            {
                Loxone = new LoxoneSection
                {
                    Host = _model.Loxone.Host,
                    Port = _model.Loxone.Port,
                    UseHttps = _model.Loxone.UseHttps,
                    User = _model.Loxone.User,
                    Password = _model.Loxone.Password
                },
                Mqtt = new MqttSection
                {
                    Host = _model.Mqtt.Host,
                    Port = _model.Mqtt.Port,
                    Username = _model.Mqtt.Username,
                    Password = _model.Mqtt.Password,
                    ClientId = _model.Mqtt.ClientId,
                    BaseTopic = _model.Mqtt.BaseTopic
                },
                Mappings = _model.Mappings.Select(m => new MappingSection
                {
                    Name = m.Name,
                    Kind = m.Kind,
                    MqttTopic = m.MqttTopic,
                    LoxoneUuidAction = m.LoxoneUuidAction
                }).ToList()
            };
            
            var json = System.Text.Json.JsonSerializer.Serialize(config);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync("/config", content);
            
            if (response.IsSuccessStatusCode)
            {
                _statusMessage = "Configuration saved successfully";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Save failed: {error}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Save error: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private string GetMappingStatus(MappingEditorModel mapping)
    {
        return $"{mapping.Kind} → {mapping.MqttTopic}";
    }
}
