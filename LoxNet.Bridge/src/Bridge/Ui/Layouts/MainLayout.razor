@inherits LayoutComponentBase

<FluentDesignSystemProvider>
    <FluentDialogProvider />
    <FluentToastProvider MaxToastCount="10" Position="ToastPosition.TopRight" />
    <FluentMessageBarProvider />

    <FluentLayout>
        <FluentHeader>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                <FluentLabel Typo="Typography.H3">LoxNet Bridge Configuration</FluentLabel>
                <FluentLabel Typo="Typography.Body">Miniserver, MQTT, and bridge mappings</FluentLabel>
            </FluentStack>
        </FluentHeader>
        <FluentBodyContent>
            @Body
        </FluentBodyContent>
    </FluentLayout>
</FluentDesignSystemProvider>
